    "act-3": [
      {
        "file": "/vo/act-3-1.m4a",
        "text": "Ideas are cheap.",
        "duration": 2.125
      },
      {
        "file": "/vo/act-3-2.m4a",
        "text": "So here is what he actually built.",
        "duration": 3
