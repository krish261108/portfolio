    "act-1": [
      {
        "file": "/vo/act-1-1.m4a",
        "text": "It started with a question.",
        "duration": 2.475
      },
      {
        "file": "/vo/act-1-2.m4a",
        "text": "What if a website could feel alive?",
        "duration": 3.05
